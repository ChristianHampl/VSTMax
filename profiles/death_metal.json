{
  "id": "death_metal",
  "name": "Death Metal",
  "extends": "_base",
  "description": "Hohe Spieldichte: klickende, durchsetzungsfähige Kick für Blastbeats (kurze Release-Zeiten), harte Gates, tiefe Gitarren mit kontrolliertem Low-Mid, Growls im Mix eingebettet statt davor, wenig Hall.",
  "balance_lu": {"kick": -1.0, "snare": -1.5, "scream_vocal": -1.5, "lead_vocal": -1.5, "rhythm_guitar": -3.0, "room": -16.0},
  "rules": {
    "low_end_owner": "kick",
    "kick_bass_duck_db": 5.0,
    "vocal_guitar_duck_db": 1.5,
    "mud_cut_max_db": 5.0,
    "parallel_drums": 0.3,
    "transient_preservation": 0.4,
    "gate_drums": true,
    "reverb_amount": 0.6
  },
  "eq": {
    "kick": {"hpf": 40, "lpf": 15000, "moves": [{"type": "bell", "freq": 420, "gain_db": -5.0, "q": 1.2}, {"type": "bell", "freq": 5000, "gain_db": 5.0, "q": 1.2}]},
    "rhythm_guitar": {"hpf": 85, "lpf": 9500, "moves": [{"type": "bell", "freq": 220, "gain_db": -2.5, "q": 1.2}, {"type": "bell", "freq": 800, "gain_db": -1.5, "q": 1.0}]}
  },
  "dynamics": {
    "kick": {"comp": {"ratio": 6.0, "target_gr_db": 5.0, "attack_ms": 5, "release_ms": 40, "knee_db": 3}, "gate": true},
    "snare": {"comp": {"ratio": 5.0, "target_gr_db": 4.0, "attack_ms": 6, "release_ms": 60, "knee_db": 4}, "gate": true}
  },
  "fx": {"reverb": {"decay_s": 1.2, "predelay_ms": 15, "damping_hz": 5500}},
  "mix_target": {"tilt_db_per_oct": -4.0, "crest_min_db": 7.5, "crest_max_db": 13.0},
  "master": {"target_lufs": -10.5, "max_limiter_gr_db": 5.0, "min_plr_db": 7.0}
}
